--- !u!114 &1621311795
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1621311792}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ea5472330afdd84085708fde5b60b30, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueScript: {fileID: 6665420}
  playableDirector: {fileID: 1863636290}
  gm: {fileID: 0}
  dialogueLines: []
  goodEndingLines:
  - timestamp: 1
    text: "Lily: Coming\u2026\u2026. J-John?\r\n\r\nJohn: Hey lily\u2026\r\n\r\nLily:
      What are you doing here?\r\n\r\nJohn: I came here, wanting to make things up..\r\n\r\nLily:
      *Sigh* John..\r\n\r\nJohn: But.. I get it now\u2026 I'm not here expecting
      anything in return, i just wanna clear the air\r\n\r\nLily:...\r\n"
    delay: 0.1
  - timestamp: 30
    text: "John: Listen, I've had a rough night, another one. But I got through it
      in one piece somehow, and feel like I understand things better after taking
      some time. It was wrong of me to use you to get me away from myself, but for
      once, I feel comfortable, being alone. I just wanted to say I'm sorry, I hope
      you find someone who can take better care of you.\r\n\r\nLily: I appreciate
      that John, I really do. I hope you do as well.\r\n\r\nJohn: Thanks, well, I\u2019ll
      get going now, if you ever wanna chat just let me know.\r\n\r\nLily: Goodnight
      John.\r\n\r\nJohn: You too.\r\n"
    delay: 0.1
  badEndingLines:
  - timestamp: 1
    text: "John: Lily! Please, I'm sorry!\r\n\r\nLily: J-John?\r\n\r\nJohn: Please
      Lily *Cries* take me back\r\n\r\nLily: I-i\r\n\r\nJohn: PLEASE!! I NEED YOU!!\n\nLily:
      Y-you know what? No! I'm done with this. You just latched onto me like you
      did to everyone else! You're a parasite who only thinks of himself. You make
      your own loneliness by treating others like your medicine! I don\u2019t have
      time for your antics anymore, I need someone who\u2019ll listen to me. You
      haven\u2019t changed a bit. Now go!\r\n\r\n"
    delay: 0.1
