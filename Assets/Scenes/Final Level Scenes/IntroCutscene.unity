MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1577300212}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ea5472330afdd84085708fde5b60b30, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueScript: {fileID: 1587598802}
  playableDirector: {fileID: 696597695}
  gm: {fileID: 524246700}
  dialogueLines:
  - timestamp: 0
    text: '*Sigh*'
    delay: 0.2
  - timestamp: 9
    text: I'm so tired...
    delay: 0.25
  - timestamp: 20
    text: I wish I can just close my eyes and sleep...
    delay: 0.05
  - timestamp: 26
    text: forever...
    delay: 0.3
  - timestamp: 34
    text: and ever...
    delay: 0.35
  - timestamp: 51
    text: No... I can't.
    delay: 0.2
  - timestamp: 55
    text: I won't be able to see Lily.
    delay: 0.1
  - timestamp: 63
    text: I wonder how she'll tie her hair this time.
    delay: 0.1
  - timestamp: 70
    text: Braided?
    delay: 0.01
  - timestamp: 72
    text: Ponytail?
    delay: 0.01
  - timestamp: 74
    text: Or maybe one of those French things she likes to do?
    delay: 0.01
  - timestamp: 80
    text: She'll look beautiful anyways.
    delay: 0.05
  - timestamp: 85
    text: She's always beautiful.
    delay: 0.1
  - timestamp: 90
    text: I- I just-
    delay: 0.1
  - timestamp: 100
    text: I hope she'll-
    delay: 0.1
  - timestamp: 110
    text: Oh...
    delay: 0.1
  - timestamp: 116
    text: It's my stop...
    delay: 0.2
