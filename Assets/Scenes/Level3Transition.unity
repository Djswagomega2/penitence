MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1527093840}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ea5472330afdd84085708fde5b60b30, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueScript: {fileID: 1355768494}
  playableDirector: {fileID: 1997233865}
  gm: {fileID: 2102174866}
  dialogueLines:
  - timestamp: 0
    text: God, I live in hell
    delay: 0.06
  - timestamp: 10
    text: Every marbled face and monster I see scares me
    delay: 0.04
  - timestamp: 15
    text: 'I don''t know why but... '
    delay: 0.08
  - timestamp: 23
    text: "I think it\u2019s because of how they feel\u2026 They all haunt me with
      reflections\u2026 and memories"
    delay: 0.1
  - timestamp: 32
    text: "like they\u2019re telling me I'm evil"
    delay: 0.05
  - timestamp: 37
    text: but I don't want to be
    delay: 0.1
  - timestamp: 44
    text: ' I''m not...'
    delay: 0.07
  - timestamp: 49
    text: " I can't stand being like this\u2026"
    delay: 0.12
  - timestamp: 57
    text: " I just want to be more\u2026"
    delay: 0.07
  - timestamp: 65
    text: ' Lily deserves more...'
    delay: 0.1
  goodEndingLines: []
  badEndingLines: []
